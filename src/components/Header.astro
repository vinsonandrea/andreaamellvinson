        <!-- Search & Navigation Header -->
        <div class="max-w-7xl mx-auto mt-6 flex flex-col md:flex-row gap-6 items-center justify-between px-4">
            <nav class="font-sans text-xs uppercase tracking-wider w-full md:w-auto">
                <ul class="flex flex-wrap justify-center gap-3 p-0 m-0 font-semibold">
                    <li
                        class="bg-white/80 dark:bg-slate-900 px-4 py-2.5 rounded-full border border-rose-200 dark:border-rose-900/50 hover:border-rose-400 shadow-sm transition-all">
                        <a href="#projects" class="text-slate-700 dark:text-slate-200 hover:text-rose-500">01.
                            Architecture Builds</a>
                    </li>
                    <li
                        class="bg-white/80 dark:bg-slate-900 px-4 py-2.5 rounded-full border border-rose-200 dark:border-rose-900/50 hover:border-rose-400 shadow-sm transition-all">
