<section id="contact" aria-labelledby="contact-title" class="mx-4 my-16 scroll-mt-8 text-left sm:mx-12 lg:mx-auto lg:max-w-7xl">
  <div class="mb-8 border-b border-rose-200 pb-4 dark:border-rose-900/50">
    <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-rose-500">Communication</span>
    <h2 id="contact-title" class="font-sans text-3xl font-bold text-slate-900 dark:text-rose-300">Let&apos;s Collaborate</h2>
  </div>

  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <article class="rounded-3xl border border-rose-100 bg-white/80 p-7 shadow-[0_10px_30px_rgba(244,63,94,0.08)] backdrop-blur-md dark:border-rose-500/20 dark:bg-slate-900/80 dark:shadow-[0_10px_30px_rgba(0,0,0,0.3)]">
      <h3 class="mb-3 text-xl font-bold text-slate-800 dark:text-white">Direct Contact Channels</h3>
      <p class="mb-6 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
        Need an enterprise cloud build, security assessment, or DevOps overhaul? Feel free to reach out directly via email or submit a message prompt.
      </p>

      <div class="space-y-3 font-sans text-xs">
        <div class="rounded-2xl border border-rose-100 bg-rose-50/60 p-4 dark:border-slate-700 dark:bg-slate-800/60">
          <span class="mb-1 block text-[10px] font-semibold uppercase text-rose-500">Direct Email</span>
          <a href="mailto:c20245391.vinson@csav.edu.ph" class="font-bold text-slate-800 hover:underline dark:text-rose-300">c20245391.vinson@csav.edu.ph</a>
        </div>
        <div class="rounded-2xl border border-rose-100 bg-rose-50/60 p-4 dark:border-slate-700 dark:bg-slate-800/60">
          <span class="mb-1 block text-[10px] font-semibold uppercase text-rose-500">Location Base</span>
          <span class="font-bold text-slate-800 dark:text-white">Western Visayas, Philippines</span>
        </div>
        <div class="rounded-2xl border border-rose-100 bg-rose-50/60 p-4 dark:border-slate-700 dark:bg-slate-800/60">
          <span class="mb-1 block text-[10px] font-semibold uppercase text-rose-500">Network Ping Latency</span>
          <span id="live-latency" class="font-bold text-slate-800 dark:text-white">18ms</span>
        </div>
      </div>
    </article>

    <article class="rounded-3xl border border-rose-100 bg-white/80 p-7 shadow-[0_10px_30px_rgba(244,63,94,0.08)] backdrop-blur-md dark:border-rose-500/20 dark:bg-slate-900/80 dark:shadow-[0_10px_30px_rgba(0,0,0,0.3)]">
      <h3 class="mb-2 text-xl font-bold text-slate-800 dark:text-white">Send a Message</h3>
      <p class="mb-6 text-xs text-slate-500 dark:text-slate-400">Enter your details below to schedule a technical architecture discussion.</p>

      <form id="contact-form" class="flex flex-col gap-4">
        <div class="flex min-w-0 flex-col gap-2 rounded-r-xl border-l-2 border-rose-400 bg-rose-50/50 p-4 hover:bg-rose-50 dark:bg-slate-800/50 dark:hover:bg-slate-800">
          <label for="name" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">Your Name</label>
          <input type="text" id="name" name="name" placeholder="e.g., Alex Vance" required autocomplete="name" class="w-full rounded-xl border border-rose-200 bg-white/90 p-3 font-medium text-slate-800 shadow-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:focus:border-rose-400 dark:focus:ring-rose-950">
        </div>
        <div class="flex min-w-0 flex-col gap-2 rounded-r-xl border-l-2 border-rose-400 bg-rose-50/50 p-4 hover:bg-rose-50 dark:bg-slate-800/50 dark:hover:bg-slate-800">
          <label for="email" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">Email Address</label>
          <input type="email" name="email" id="email" placeholder="client@company.com" required autocomplete="email" class="w-full rounded-xl border border-rose-200 bg-white/90 p-3 font-medium text-slate-800 shadow-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:focus:border-rose-400 dark:focus:ring-rose-950">
        </div>
        <div class="flex min-w-0 flex-col gap-2 rounded-r-xl border-l-2 border-rose-400 bg-rose-50/50 p-4 hover:bg-rose-50 dark:bg-slate-800/50 dark:hover:bg-slate-800">
          <label for="message" class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">Project Scope</label>
          <textarea name="message" id="message" rows="3" placeholder="Describe your architecture requirements or goals..." required class="w-full rounded-xl border border-rose-200 bg-white/90 p-3 font-medium text-slate-800 shadow-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-200 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:focus:border-rose-400 dark:focus:ring-rose-950"></textarea>
        </div>
        <button type="submit" class="mt-2 cursor-pointer rounded-full border-2 border-rose-300 bg-rose-500 px-6 py-3 font-semibold text-white shadow-[0px_4px_14px_0px_rgba(244,63,94,0.39)] transition-all hover:bg-rose-600">Send Message</button>
      </form>
    </article>
  </div>
</section>

<dialog id="modal" aria-labelledby="modal-title" class="mx-auto my-auto w-full max-w-md rounded-3xl border border-rose-200 bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
  <div class="p-8 text-left font-sans">
    <h3 id="modal-title" class="mb-3 border-b border-rose-100 pb-2 text-lg font-bold uppercase text-rose-500 dark:border-slate-800">Message Ready</h3>
    <p class="mb-6 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
      Your message is prepared. Continue in your email app to send it.
    </p>
    <button id="close-modal" type="button" class="w-full cursor-pointer rounded-full border-2 border-rose-300 bg-rose-500 px-6 py-3 text-center font-semibold text-white shadow-[0px_4px_14px_0px_rgba(244,63,94,0.39)] transition-all hover:bg-rose-600">
      Open email app
    </button>
  </div>
</dialog>