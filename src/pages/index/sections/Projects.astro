---
const patterns = [
  {
    number: '01',
    label: 'Cloud Mesh',
    title: 'Kubernetes Mesh Engine',
    description: 'Auto-scaling zero-trust Kubernetes cluster with Istio service mesh, managing cross-region failover and distributed ingress pipelines.',
    stack: 'K8s, Istio, Terraform, AWS EKS',
    result: '< 4ms Internal Routing',
  },
  {
    number: '02',
    label: 'Security Engine',
    title: 'SIEM Threat Analyzer',
    description: 'Security event correlation engine consuming 50K events/sec to flag anomalous ingress patterns and automatically inject firewall rules.',
    stack: 'Go, Elastic, Apache Kafka, Suricata',
    result: 'Active Threat Deflection',
  },
  {
    number: '03',
    label: 'Global Edge',
    title: 'Global Edge Cache CDN',
    description: 'Custom CDN distribution layer serving edge-cached static assets and API responses to maintain zero-latency user experiences globally.',
    stack: 'Cloudflare Workers, Rust, Redis Edge',
    result: '99.4% Edge Cache Hit Ratio',
  },
];
---

<section id="projects" aria-labelledby="projects-title" class="mx-4 my-16 scroll-mt-8 text-left sm:mx-12 lg:mx-auto lg:max-w-7xl">
  <div class="mb-8 flex items-end justify-between border-b border-rose-200 pb-4 dark:border-rose-900/50">
    <div>
      <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-rose-500">Portfolio</span>
      <h2 id="projects-title" class="font-sans text-3xl font-bold text-slate-900 dark:text-rose-300">Featured Deployments</h2>
    </div>
    <span class="hidden font-mono text-xs font-semibold text-purple-600 dark:text-purple-400 sm:inline">3 CLOUD ARCHITECTURES LIVE</span>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {patterns.map((pattern) => (
      <article class="flex min-w-0 flex-1 flex-col justify-between rounded-3xl border border-rose-100 bg-white/80 p-7 shadow-[0_10px_30px_rgba(244,63,94,0.08)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(244,63,94,0.15)] dark:border-rose-500/20 dark:bg-slate-900/80 dark:shadow-[0_10px_30px_rgba(0,0,0,0.3)] dark:hover:border-rose-400/40">
        <div>
          <span class="mb-3 inline-block rounded-full bg-rose-100 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-rose-700 dark:bg-rose-900/50 dark:text-rose-200">{pattern.label}</span>
          <h3 class="mb-2 text-xl font-bold text-slate-800 dark:text-white">{pattern.title}</h3>
          <p class="mb-6 text-xs leading-relaxed text-slate-600 dark:text-slate-300">{pattern.description}</p>
        </div>
        <ul class="space-y-1.5 border-t border-rose-100 pt-4 font-sans text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
          <li><strong class="text-rose-500">Stack:</strong> {pattern.stack}</li>
          <li><strong class="text-rose-500">Result:</strong> {pattern.result}</li>
        </ul>
      </article>
    ))}
  </div>
</section>